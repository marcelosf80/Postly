<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Producción: Solo HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Desarrollo: Permitir HTTP solo para localhost y emulador -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
    </domain-config>

    <!-- Dominio de producción: Forzar HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">marketing-4778.onrender.com</domain>
        <domain includeSubdomains="true">postly-z7cf.onrender.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Meta/Facebook APIs -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">graph.facebook.com</domain>
        <domain includeSubdomains="true">connect.facebook.net</domain>
        <domain includeSubdomains="true">accounts.google.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
