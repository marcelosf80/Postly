# Marketing SaaS — Variables de Entorno
# Copiar este archivo como .env y completar los valores

# === Servidor ===
PORT=3000
JWT_SECRET=cambiar-esto-en-produccion-usar-clave-larga-y-aleatoria

# === IA para Generación de Contenido ===
# Solo necesitás UNA de estas opciones (el sistema detecta automáticamente)

# Opción 1: Meta Llama API (RECOMENDADO - Gratis, especializado en redes sociales)
# Obtener key en: https://www.llama-api.com/
# META_LLAMA_API_KEY=tu_clave_aqui

# Opción 2: Groq (Llama ultra-rápido - Gratis tier generoso)
# Obtener key en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui

# Opción 3: OpenAI (GPT-4 - Pago, muy bueno)
# Obtener key en: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-tu_clave_openai

# Opción 4: Claude (Anthropic - Pago, excelente calidad)
# Obtener key en: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-tu_clave_de_claude

# === Meta / Instagram / Facebook ===
META_APP_ID=tu_app_id
META_APP_SECRET=tu_app_secret

# Alternativo (mismo valor):
FACEBOOK_APP_ID=tu_app_id
FACEBOOK_APP_SECRET=tu_app_secret

# === Mercado Pago (Opcional - Fase 4) ===
# MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
# MP_PUBLIC_KEY=tu_public_key

# === Google Auth ===
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com

