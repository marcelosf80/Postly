# Marketing SaaS — Variables de Entorno
# Copiar este archivo como .env y completar los valores

# === Servidor ===
PORT=3000
JWT_SECRET=cambiar-esto-en-produccion-usar-clave-larga-y-aleatoria

# === DeepSeek (texto, captions, visión y prompts) ===
# Crear la clave en https://platform.deepseek.com/
DEEPSEEK_API_KEY=tu_api_key_de_deepseek
DEEPSEEK_MODEL=deepseek-flash

# === Generación/edición de imágenes desde una foto de referencia ===
# Crear la clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# === Meta / Instagram / Facebook ===
META_APP_ID=tu_app_id
META_APP_SECRET=tu_app_secret

# Alternativo (mismo valor):
FACEBOOK_APP_ID=tu_app_id
FACEBOOK_APP_SECRET=tu_app_secret

# === Mercado Pago (Opcional - Fase 4) ===
# MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
# MP_PUBLIC_KEY=tu_public_key

# === Google Auth ===
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com

# === Google Cloud Vertex AI (Imagen 3) ===
GCP_PROJECT_ID=tu_proyecto_id_aqui
GCP_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/a/tu/service-account.json
